DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=flight_ops
POSTGRES_USER=flight_ops
POSTGRES_PASSWORD=replace-with-a-local-password

# Production: use config.production, a random 50+ character secret and explicit hosts.
# REDIS_URL=redis://redis:6379/0
# Enable only when a trusted HTTPS proxy strips incoming forwarded headers:
# DJANGO_TRUST_PROXY=true
# DJANGO_NUM_PROXIES=1
